@model BravoWeb.Models.ContentFragment
@{
    ViewData["Title"] = "Edit Content Fragment";
    int? pageId = ViewBag.PageId as int?;
}

<div class="cms-page">
    <h1>Edit Content Fragment</h1>

    <form asp-action="Edit" method="post" onsubmit="return syncEditors()" class="cms-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="validation-error"></span>
        </div>

        <div style="margin-top:12px;">
            <!-- Bootstrap Nav Tabs -->
            <ul class="nav nav-tabs" id="editorTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="html-tab" data-bs-toggle="tab" data-bs-target="#htmlPane"
                            type="button" role="tab" aria-controls="htmlPane" aria-selected="true">HTML</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="css-tab" data-bs-toggle="tab" data-bs-target="#cssPane"
                            type="button" role="tab" aria-controls="cssPane" aria-selected="false">CSS</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="js-tab" data-bs-toggle="tab" data-bs-target="#jsPane"
                            type="button" role="tab" aria-controls="jsPane" aria-selected="false">JavaScript</button>
                </li>
            </ul>

            <!-- Tab Panes -->
            <div class="tab-content" id="editorTabContent">
                <div class="tab-pane fade show active" id="htmlPane" role="tabpanel" aria-labelledby="html-tab">
                    <textarea asp-for="HtmlContent" id="htmlContent" style="display:none;"></textarea>
                    <div id="htmlEditor" style="height:480px;border:1px solid #ddd;border-top:none;"></div>
                </div>
                <div class="tab-pane fade" id="cssPane" role="tabpanel" aria-labelledby="css-tab">
                    <textarea asp-for="CssContent" id="cssContent" style="display:none;"></textarea>
                    <div id="cssEditor" style="height:480px;border:1px solid #ddd;border-top:none;"></div>
                </div>
                <div class="tab-pane fade" id="jsPane" role="tabpanel" aria-labelledby="js-tab">
                    <textarea asp-for="JsContent" id="jsContent" style="display:none;"></textarea>
                    <div id="jsEditor" style="height:480px;border:1px solid #ddd;border-top:none;"></div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button id="saveBtn" type="submit" class="btn-cms btn-cms-primary">Save</button>
            <a asp-action="Index" asp-route-pageId="@pageId" class="btn-cms btn-cms-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/monaco/vs/loader.js"></script>
    <script>
        require.config({ paths: { 'vs': '/lib/monaco/vs' }});
        var htmlEditor, cssEditor, jsEditor;
        document.getElementById('saveBtn').disabled = true;

        require(['vs/editor/editor.main'], function () {
            htmlEditor = monaco.editor.create(document.getElementById('htmlEditor'), {
                value: document.getElementById('htmlContent').value || '',
                language: 'html',
                automaticLayout: true,
                minimap: { enabled: false }
            });
            cssEditor = monaco.editor.create(document.getElementById('cssEditor'), {
                value: document.getElementById('cssContent').value || '',
                language: 'css',
                automaticLayout: true,
                minimap: { enabled: false }
            });
            jsEditor = monaco.editor.create(document.getElementById('jsEditor'), {
                value: document.getElementById('jsContent').value || '',
                language: 'javascript',
                automaticLayout: true,
                minimap: { enabled: false }
            });
            document.getElementById('saveBtn').disabled = false;

            // Re-layout editors when switching tabs so they render correctly
            document.querySelectorAll('#editorTabs button[data-bs-toggle="tab"]').forEach(function (tab) {
                tab.addEventListener('shown.bs.tab', function () {
                    if (htmlEditor) htmlEditor.layout();
                    if (cssEditor) cssEditor.layout();
                    if (jsEditor) jsEditor.layout();
                });
            });
        });

        function syncEditors() {
            if (htmlEditor) document.getElementById('htmlContent').value = htmlEditor.getValue();
            if (cssEditor) document.getElementById('cssContent').value = cssEditor.getValue();
            if (jsEditor) document.getElementById('jsContent').value = jsEditor.getValue();
            return true;
        }
    </script>
}
