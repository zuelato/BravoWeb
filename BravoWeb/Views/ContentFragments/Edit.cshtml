@model BravoWeb.Models.ContentFragment
@{
    ViewData["Title"] = "Edit Content Fragment";
    int? pageId = ViewBag.PageId as int?;
    var isTemplateBased = Model.TemplateId.HasValue && Model.Template != null;
}

<div class="cms-page">
    <h1>Edit Content Fragment</h1>

    <form asp-action="Edit" method="post" onsubmit="return syncEditors()" class="cms-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="TemplateId" />
        <input type="hidden" id="dataJsonField" name="DataJson" value="@(Model.DataJson ?? "")" />
        <input type="hidden" id="htmlContent" name="HtmlContent" value="@(isTemplateBased ? "<!-- rendered from template -->" : Model.HtmlContent)" />
        <input type="hidden" id="cssContent" name="CssContent" value="@(isTemplateBased ? "" : Model.CssContent)" />
        <input type="hidden" id="jsContent" name="JsContent" value="@(isTemplateBased ? "" : Model.JsContent)" />

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="validation-error"></span>
        </div>

        @if (isTemplateBased)
        {
            <!-- Template Mode: show data form -->
            <div style="margin-top:12px;">
                <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; padding:16px; margin-bottom:16px;">
                    <h5 style="margin:0 0 4px 0; color:#16a34a;">📐 Template: @Model.Template!.Name</h5>
                    <p style="color:#666; font-size:13px; margin:0;">Chỉnh sửa dữ liệu bên dưới. Cấu trúc HTML/CSS/JS được quản lý bởi template.</p>
                </div>

                <div id="dataForm">
                    <!-- Placeholder inputs generated by JS -->
                </div>

                <details style="margin-top:16px;">
                    <summary style="cursor:pointer; color:#666; font-size:13px;">Xem HTML template (chỉ đọc)</summary>
                    <pre style="background:#f5f5f5; padding:12px; border-radius:6px; font-size:12px; max-height:300px; overflow:auto; margin-top:8px;">@Model.Template!.HtmlContent</pre>
                </details>
            </div>
        }
        else
        {
            <!-- Raw Mode: Monaco editors -->
            <div style="margin-top:12px;">
                <ul class="nav nav-tabs" id="editorTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="html-tab" data-bs-toggle="tab" data-bs-target="#htmlPane"
                                type="button" role="tab" aria-controls="htmlPane" aria-selected="true">HTML</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="css-tab" data-bs-toggle="tab" data-bs-target="#cssPane"
                                type="button" role="tab" aria-controls="cssPane" aria-selected="false">CSS</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="js-tab" data-bs-toggle="tab" data-bs-target="#jsPane"
                                type="button" role="tab" aria-controls="jsPane" aria-selected="false">JavaScript</button>
                    </li>
                </ul>

                <div class="tab-content" id="editorTabContent">
                    <div class="tab-pane fade show active" id="htmlPane" role="tabpanel" aria-labelledby="html-tab">
                        <textarea id="htmlContentEditor" style="display:none;">@Model.HtmlContent</textarea>
                        <div id="htmlEditor" style="height:480px;border:1px solid #ddd;border-top:none;"></div>
                    </div>
                    <div class="tab-pane fade" id="cssPane" role="tabpanel" aria-labelledby="css-tab">
                        <textarea id="cssContentEditor" style="display:none;">@Model.CssContent</textarea>
                        <div id="cssEditor" style="height:480px;border:1px solid #ddd;border-top:none;"></div>
                    </div>
                    <div class="tab-pane fade" id="jsPane" role="tabpanel" aria-labelledby="js-tab">
                        <textarea id="jsContentEditor" style="display:none;">@Model.JsContent</textarea>
                        <div id="jsEditor" style="height:480px;border:1px solid #ddd;border-top:none;"></div>
                    </div>
                </div>
            </div>
        }

        <div class="form-actions">
            <button id="saveBtn" type="submit" class="btn-cms btn-cms-primary">Save</button>
            <a asp-action="Index" asp-route-pageId="@pageId" class="btn-cms btn-cms-secondary">Cancel</a>
        </div>
    </form>
</div>

<style>
    .data-field-group { margin-bottom: 14px; }
    .data-field-group label { display: block; font-weight: 600; margin-bottom: 4px; font-size: 13px; color: #333; }
    .data-field-group input,
    .data-field-group textarea { width: 100%; padding: 8px 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; }
    .data-field-group textarea { min-height: 80px; resize: vertical; }
</style>

@section Scripts {
    @if (isTemplateBased)
    {
        <script>
            // Template mode: generate data form from placeholders
            (function () {
                var templateHtml = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Template!.HtmlContent ?? ""));
                var dataJson = @Html.Raw(Model.DataJson ?? "{}");

                // Extract {{KEY}} placeholders
                var matches = templateHtml.match(/\{\{([A-Z0-9_]+)\}\}/g) || [];
                var keys = [];
                var seen = {};
                matches.forEach(function (m) {
                    var key = m.replace(/[{}]/g, '');
                    if (!seen[key]) { seen[key] = true; keys.push(key); }
                });

                var container = document.getElementById('dataForm');
                keys.forEach(function (key) {
                    var value = dataJson[key] || '';
                    var isLong = value.length > 80;
                    var group = document.createElement('div');
                    group.className = 'data-field-group';

                    var label = document.createElement('label');
                    label.textContent = key;
                    group.appendChild(label);

                    var input;
                    if (isLong) {
                        input = document.createElement('textarea');
                    } else {
                        input = document.createElement('input');
                        input.type = 'text';
                    }
                    input.name = 'data_' + key;
                    input.value = value;
                    input.dataset.key = key;
                    input.className = 'data-input';
                    group.appendChild(input);

                    container.appendChild(group);
                });
            })();

            function syncEditors() {
                // Collect all data inputs into a JSON object
                var data = {};
                document.querySelectorAll('.data-input').forEach(function (el) {
                    data[el.dataset.key] = el.value;
                });
                document.getElementById('dataJsonField').value = JSON.stringify(data);
                document.getElementById('htmlContent').value = '<!-- rendered from template -->';
                return true;
            }
        </script>
    }
    else
    {
        <script src="~/lib/monaco/vs/loader.js"></script>
        <script>
            require.config({ paths: { 'vs': '/lib/monaco/vs' }});
            var htmlEditor, cssEditor, jsEditor;
            document.getElementById('saveBtn').disabled = true;

            require(['vs/editor/editor.main'], function () {
                htmlEditor = monaco.editor.create(document.getElementById('htmlEditor'), {
                    value: document.getElementById('htmlContentEditor').value || '',
                    language: 'html',
                    automaticLayout: true,
                    minimap: { enabled: false }
                });
                cssEditor = monaco.editor.create(document.getElementById('cssEditor'), {
                    value: document.getElementById('cssContentEditor').value || '',
                    language: 'css',
                    automaticLayout: true,
                    minimap: { enabled: false }
                });
                jsEditor = monaco.editor.create(document.getElementById('jsEditor'), {
                    value: document.getElementById('jsContentEditor').value || '',
                    language: 'javascript',
                    automaticLayout: true,
                    minimap: { enabled: false }
                });
                document.getElementById('saveBtn').disabled = false;

                // Re-layout editors when switching tabs so they render correctly
                document.querySelectorAll('#editorTabs button[data-bs-toggle="tab"]').forEach(function (tab) {
                    tab.addEventListener('shown.bs.tab', function () {
                        if (htmlEditor) htmlEditor.layout();
                        if (cssEditor) cssEditor.layout();
                        if (jsEditor) jsEditor.layout();
                    });
                });
            });

            function syncEditors() {
                if (htmlEditor) document.getElementById('htmlContent').value = htmlEditor.getValue();
                if (cssEditor) document.getElementById('cssContent').value = cssEditor.getValue();
                if (jsEditor) document.getElementById('jsContent').value = jsEditor.getValue();
                return true;
            }
        </script>
    }
}
