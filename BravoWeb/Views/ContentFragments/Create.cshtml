@model BravoWeb.Models.ContentFragment
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Create Content Fragment";
    var tinymceKey = Configuration["TinyMce:ApiKey"];
    var tinymceUrl = $"https://cdn.tiny.cloud/1/{tinymceKey}/tinymce/6/tinymce.min.js";
}

<h1>Create Content Fragment</h1>

<form asp-action="Create" method="post">
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label asp-for="DisplayOrder"></label>
        <input asp-for="DisplayOrder" type="number" />
    </div>
    <div>
        <label asp-for="HtmlContent">HTML Content</label>
        <textarea asp-for="HtmlContent" id="htmlContent" rows="15" cols="80"></textarea>
    </div>

    <div>
        <button type="submit">Create</button>
        <a asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="@tinymceUrl" referrerpolicy="origin"></script>
    <script>
        tinymce.init({ selector: '#htmlContent', menubar: false });
    </script>
}
