@model BravoWeb.Models.ContentFragment
@{
    ViewData["Title"] = "Create Content Fragment";
    int? pageId = ViewBag.PageId as int?;
}

<div class="cms-page">
    <h1>Tạo Nội Dung Mới</h1>

    <!-- Template Picker -->
    <div id="templatePicker">
        <h4 style="margin-bottom:4px;">Chọn Template</h4>
        <p style="color:#666;margin-bottom:16px;">Chọn mẫu nội dung cho nội dung mới của bạn.</p>

        <div id="templateCards" style="display:flex; gap:16px; flex-wrap:wrap;">
            <!-- Built-in cards injected dynamically from templates.json -->
            <!-- Custom cards injected from /api/custom-templates -->
            <!-- "Create Your Own" card (always last) -->
            <div class="template-card create-own-card" onclick="openSaveTemplateModal()">
                <div class="template-icon">✨</div>
                <h5>Tạo mẫu riêng</h5>
                <p>Tạo template tùy chỉnh để sử dụng lại sau.</p>
            </div>
        </div>
    </div>

    <!-- Save-as-Template Modal -->
    <div id="saveTemplateModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:1000; display:none; align-items:center; justify-content:center;">
        <div style="background:#fff; border-radius:10px; padding:28px; width:420px; max-width:90vw; box-shadow:0 12px 40px rgba(0,0,0,0.2);">
            <h4 style="margin:0 0 16px 0;">Lưu Template Mới</h4>
            <div class="cms-form">
                <div class="form-group">
                    <label>Tên template *</label>
                    <input type="text" id="tmplName" placeholder="VD: Hero Banner, Contact Form..." />
                </div>
                <div class="form-group">
                    <label>Icon (emoji)</label>
                    <input type="text" id="tmplIcon" value="🧩" style="width:60px;" />
                </div>
                <div class="form-group">
                    <label>Mô tả ngắn</label>
                    <input type="text" id="tmplDesc" placeholder="Mô tả ngắn về template này" />
                </div>

                <p style="color:#666; font-size:13px; margin-bottom:12px;">
                    Bạn sẽ chỉnh sửa nội dung HTML/CSS/JS trong editor. Sau khi bấm <strong>Lưu Template</strong>, mẫu sẽ được lưu lại để dùng cho lần sau.
                </p>

                <div class="form-actions">
                    <button type="button" class="btn-cms btn-cms-primary" onclick="startCustomTemplate()">Tiếp tục</button>
                    <button type="button" class="btn-cms btn-cms-secondary" onclick="closeSaveTemplateModal()">Huỷ</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Editor Form (hidden until a template is chosen) -->
    <div id="editorSection" style="display:none;">
        <form asp-action="Create" method="post" onsubmit="return syncEditors()" class="cms-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PageId" value="@(pageId?.ToString() ?? "")" />
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="validation-error"></span>
            </div>

            <div style="margin-top:12px;">
                <!-- Bootstrap Nav Tabs -->
                <ul class="nav nav-tabs" id="editorTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="html-tab" data-bs-toggle="tab" data-bs-target="#htmlPane"
                                type="button" role="tab" aria-controls="htmlPane" aria-selected="true">HTML</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="css-tab" data-bs-toggle="tab" data-bs-target="#cssPane"
                                type="button" role="tab" aria-controls="cssPane" aria-selected="false">CSS</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="js-tab" data-bs-toggle="tab" data-bs-target="#jsPane"
                                type="button" role="tab" aria-controls="jsPane" aria-selected="false">JavaScript</button>
                    </li>
                </ul>

                <!-- Tab Panes -->
                <div class="tab-content" id="editorTabContent">
                    <div class="tab-pane fade show active" id="htmlPane" role="tabpanel" aria-labelledby="html-tab">
                        <textarea asp-for="HtmlContent" id="htmlContent" style="display:none;"></textarea>
                        <div id="htmlEditor" style="height:480px;border:1px solid #ddd;border-top:none;"></div>
                    </div>
                    <div class="tab-pane fade" id="cssPane" role="tabpanel" aria-labelledby="css-tab">
                        <textarea asp-for="CssContent" id="cssContent" style="display:none;"></textarea>
                        <div id="cssEditor" style="height:480px;border:1px solid #ddd;border-top:none;"></div>
                    </div>
                    <div class="tab-pane fade" id="jsPane" role="tabpanel" aria-labelledby="js-tab">
                        <textarea asp-for="JsContent" id="jsContent" style="display:none;"></textarea>
                        <div id="jsEditor" style="height:480px;border:1px solid #ddd;border-top:none;"></div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button id="saveBtn" type="submit" class="btn-cms btn-cms-primary">Create</button>
                <!-- Save-as-template button (only visible when creating a custom template) -->
                <button id="saveAsTemplateBtn" type="button" class="btn-cms btn-cms-secondary" style="display:none;"
                        onclick="saveAsTemplate()">
                    💾 Lưu Template
                </button>
                <a asp-action="Index" asp-route-pageId="@pageId" class="btn-cms btn-cms-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<style>
    .template-card {
        width: 200px;
        border: 2px solid #ddd;
        border-radius: 8px;
        padding: 24px 16px;
        cursor: pointer;
        text-align: center;
        transition: border-color 0.2s, box-shadow 0.2s;
        background: #fff;
    }
    .template-card:hover {
        border-color: #00a88e !important;
        box-shadow: 0 4px 12px rgba(0,168,142,0.15);
    }
    .template-card .template-icon {
        font-size: 36px;
        margin-bottom: 12px;
        color: #888;
    }
    .template-card h5 {
        margin: 0 0 6px 0;
        font-weight: 600;
    }
    .template-card p {
        margin: 0;
        font-size: 13px;
        color: #888;
    }
    /* "Create your own" card — dashed border */
    .create-own-card {
        border-style: dashed;
        border-color: #00a88e;
    }
    .create-own-card .template-icon { color: #00a88e; }
    .create-own-card h5 { color: #00a88e; }
    /* Custom template cards — subtle accent */
    .custom-template-card {
        border-color: #c5a3ff;
    }
    .custom-template-card:hover {
        border-color: #9b6dff !important;
        box-shadow: 0 4px 12px rgba(155,109,255,0.15);
    }
    /* Delete badge on custom cards */
    .custom-template-card .delete-tmpl {
        position: absolute;
        top: 6px;
        right: 6px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #e74c3c;
        color: #fff;
        font-size: 13px;
        line-height: 22px;
        text-align: center;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.15s;
    }
    .custom-template-card:hover .delete-tmpl { opacity: 1; }
</style>

@section Scripts {
    <script src="~/lib/monaco/vs/loader.js"></script>
    <script>
        require.config({ paths: { 'vs': '/lib/monaco/vs' }});
        var htmlEditor, cssEditor, jsEditor;
        var templateManifest = [];
        var isCustomTemplateMode = false;
        var pendingCustomMeta = {};

        // ── Load built-in templates from manifest ──
        (function () {
            var container = document.getElementById('templateCards');
            var createOwnCard = container.querySelector('.create-own-card');

            // 1) Load built-in templates
            fetch('/templates/templates.json')
                .then(function (r) { return r.json(); })
                .then(function (templates) {
                    templateManifest = templates;
                    templates.forEach(function (t) {
                        var card = document.createElement('div');
                        card.className = 'template-card';
                        card.onclick = function () { selectTemplate(t.id); };
                        card.innerHTML =
                            '<div class="template-icon">' + t.icon + '</div>' +
                            '<h5>' + t.name + '</h5>' +
                            '<p>' + t.description + '</p>';
                        container.insertBefore(card, createOwnCard);
                    });

                    // 2) Then load custom templates
                    return fetch('/api/custom-templates');
                })
                .then(function (r) { return r.json(); })
                .then(function (customs) {
                    customs.forEach(function (ct) {
                        var card = document.createElement('div');
                        card.className = 'template-card custom-template-card';
                        card.style.position = 'relative';
                        card.onclick = function (e) {
                            if (e.target.classList.contains('delete-tmpl')) return;
                            selectCustomTemplate(ct.id);
                        };
                        var numericId = ct.id.replace('custom-', '');
                        card.innerHTML =
                            '<div class="delete-tmpl" title="Xoá template" onclick="deleteCustomTemplate(' + numericId + ', this.parentElement)">×</div>' +
                            '<div class="template-icon">' + ct.icon + '</div>' +
                            '<h5>' + ct.name + '</h5>' +
                            '<p>' + ct.description + '</p>';
                        container.insertBefore(card, createOwnCard);
                    });
                });
        })();

        // ── Fetch a built-in template file ──
        function fetchTemplateFile(filename) {
            if (!filename) return Promise.resolve('');
            return fetch('/templates/' + filename)
                .then(function (r) { return r.ok ? r.text() : ''; })
                .catch(function () { return ''; });
        }

        // ── Select a built-in template ──
        function selectTemplate(templateId) {
            isCustomTemplateMode = false;
            document.getElementById('saveAsTemplateBtn').style.display = 'none';

            var tmpl = templateManifest.find(function (t) { return t.id === templateId; });
            var files = (tmpl && tmpl.files) || {};

            Promise.all([
                fetchTemplateFile(files.html),
                fetchTemplateFile(files.css),
                fetchTemplateFile(files.js)
            ]).then(function (results) {
                initEditors(results[0], results[1], results[2]);
            });
        }

        // ── Select a custom template ──
        function selectCustomTemplate(compositeId) {
            isCustomTemplateMode = false;
            document.getElementById('saveAsTemplateBtn').style.display = 'none';

            var numericId = compositeId.replace('custom-', '');
            fetch('/api/custom-templates/' + numericId)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    initEditors(data.html, data.css, data.js);
                });
        }

        // ── Delete a custom template ──
        function deleteCustomTemplate(id, cardEl) {
            if (!confirm('Xoá template này?')) return;
            fetch('/api/custom-templates/' + id, { method: 'DELETE' })
                .then(function (r) {
                    if (r.ok && cardEl) cardEl.remove();
                });
        }

        // ── "Create Your Own" flow ──
        function openSaveTemplateModal() {
            var modal = document.getElementById('saveTemplateModal');
            modal.style.display = 'flex';
        }

        function closeSaveTemplateModal() {
            document.getElementById('saveTemplateModal').style.display = 'none';
        }

        function startCustomTemplate() {
            var name = document.getElementById('tmplName').value.trim();
            if (!name) { alert('Vui lòng nhập tên template.'); return; }

            pendingCustomMeta = {
                name: name,
                icon: document.getElementById('tmplIcon').value.trim() || '🧩',
                description: document.getElementById('tmplDesc').value.trim() || ''
            };
            isCustomTemplateMode = true;

            closeSaveTemplateModal();
            initEditors('', '', '');

            // Show "Save Template" button
            document.getElementById('saveAsTemplateBtn').style.display = '';
        }

        // ── Save current editor content as a reusable custom template ──
        function saveAsTemplate() {
            if (!htmlEditor) return;

            var payload = {
                name: pendingCustomMeta.name,
                icon: pendingCustomMeta.icon,
                description: pendingCustomMeta.description,
                html: htmlEditor.getValue(),
                css: cssEditor.getValue(),
                js: jsEditor.getValue()
            };

            fetch('/api/custom-templates', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.id) {
                    alert('Template "' + pendingCustomMeta.name + '" đã được lưu! Bạn có thể sử dụng lại nó lần sau.');
                    document.getElementById('saveAsTemplateBtn').style.display = 'none';
                    isCustomTemplateMode = false;
                } else {
                    alert('Lỗi: ' + (data.error || 'Không thể lưu template.'));
                }
            })
            .catch(function () {
                alert('Lỗi kết nối, không thể lưu template.');
            });
        }

        // ── Initialise Monaco editors with given content ──
        function initEditors(initialHtml, initialCss, initialJs) {
            document.getElementById('templatePicker').style.display = 'none';
            document.getElementById('editorSection').style.display = 'block';
            document.getElementById('saveBtn').disabled = true;

            require(['vs/editor/editor.main'], function () {
                htmlEditor = monaco.editor.create(document.getElementById('htmlEditor'), {
                    value: initialHtml || '',
                    language: 'html',
                    automaticLayout: true,
                    minimap: { enabled: false }
                });
                cssEditor = monaco.editor.create(document.getElementById('cssEditor'), {
                    value: initialCss || '',
                    language: 'css',
                    automaticLayout: true,
                    minimap: { enabled: false }
                });
                jsEditor = monaco.editor.create(document.getElementById('jsEditor'), {
                    value: initialJs || '',
                    language: 'javascript',
                    automaticLayout: true,
                    minimap: { enabled: false }
                });
                document.getElementById('saveBtn').disabled = false;

                document.querySelectorAll('#editorTabs button[data-bs-toggle="tab"]').forEach(function (tab) {
                    tab.addEventListener('shown.bs.tab', function () {
                        if (htmlEditor) htmlEditor.layout();
                        if (cssEditor) cssEditor.layout();
                        if (jsEditor) jsEditor.layout();
                    });
                });
            });
        }

        function syncEditors() {
            if (htmlEditor) document.getElementById('htmlContent').value = htmlEditor.getValue();
            if (cssEditor) document.getElementById('cssContent').value = cssEditor.getValue();
            if (jsEditor) document.getElementById('jsContent').value = jsEditor.getValue();
            return true;
        }
    </script>
}
