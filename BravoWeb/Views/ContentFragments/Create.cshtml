@model BravoWeb.Models.ContentFragment
@{
    ViewData["Title"] = "Create Content Fragment";
    int? pageId = ViewBag.PageId as int?;
}

<div class="cms-page">
    <h1>Tạo Nội Dung Mới</h1>

    <!-- Template Picker -->
    <div id="templatePicker">
        <h4 style="margin-bottom:4px;">Chọn Template</h4>
        <p style="color:#666;margin-bottom:16px;">Chọn mẫu nội dung cho nội dung mới của bạn.</p>

        <div id="templateCards" style="display:flex; gap:16px; flex-wrap:wrap;">
            <!-- Built-in cards injected dynamically from templates.json -->
            <!-- Custom cards injected from /api/custom-templates -->
            <!-- "Create Your Own" card (always last) -->
            <div class="template-card create-own-card" onclick="startCustomTemplate()">
                <div class="template-icon">+</div>
                <h5>Tạo mẫu riêng</h5>
                <p>Tạo template tùy chỉnh để sử dụng lại sau.</p>
            </div>
        </div>
    </div>

    <!-- Editor Form (hidden until a template is chosen) -->
    <div id="editorSection" style="display:none;">
        <form asp-action="Create" method="post" onsubmit="return syncEditors()" class="cms-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PageId" value="@(pageId?.ToString() ?? "")" />
            <input type="hidden" id="templateIdField" name="TemplateId" value="" />
            <input type="hidden" id="dataJsonField" name="DataJson" value="" />

            <!-- Custom template metadata (only visible in custom template mode) -->
            <div id="customTemplateMeta" style="display:none; background:#f8f5ff; border:1px solid #e0d4f5; border-radius:8px; padding:16px; margin-bottom:16px;">
                <h5 style="margin:0 0 12px 0; color:#7c3aed;">Thông tin Template</h5>
                <div style="display:flex; gap:16px; flex-wrap:wrap; align-items:flex-end;">
                    <div class="form-group" style="flex:1; min-width:200px; margin-bottom:0;">
                        <label>Tên template *</label>
                        <input type="text" id="tmplName" placeholder="VD: Banner, Contact Form..." />
                    </div>
                    <div class="form-group" style="width:80px; margin-bottom:0;">
                        <label>Icon</label>
                        <input type="text" id="tmplIcon" value="" style="width:60px;" />
                    </div>
                    <div class="form-group" style="flex:1; min-width:200px; margin-bottom:0;">
                        <label>Mô tả ngắn</label>
                        <input type="text" id="tmplDesc" placeholder="Mô tả ngắn về template này" />
                    </div>
                </div>
            </div>

            <!-- Template info banner (visible when using a template with placeholders) -->
            <div id="templateInfoBanner" style="display:none; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; padding:16px; margin-bottom:16px;">
                <h5 style="margin:0 0 4px 0; color:#16a34a;">📐 Template: <span id="templateInfoName"></span></h5>
                <p style="color:#666; font-size:13px; margin:0;">Điền dữ liệu bên dưới. Cấu trúc HTML/CSS/JS được quản lý bởi template.</p>
            </div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="validation-error"></span>
            </div>

            <!-- Data form for template mode (hidden by default) -->
            <div id="dataFormSection" style="display:none; margin-top:12px;">
                <div id="dataForm"></div>
                <details style="margin-top:16px;">
                    <summary style="cursor:pointer; color:#666; font-size:13px;">Xem HTML template (chỉ đọc)</summary>
                    <pre id="templatePreview" style="background:#f5f5f5; padding:12px; border-radius:6px; font-size:12px; max-height:300px; overflow:auto; margin-top:8px;"></pre>
                </details>
            </div>

            <!-- Raw editor for raw/blank mode (hidden by default) -->
            <div id="rawEditorSection" style="display:none; margin-top:12px;">
                <ul class="nav nav-tabs" id="editorTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="html-tab" data-bs-toggle="tab" data-bs-target="#htmlPane"
                                type="button" role="tab" aria-controls="htmlPane" aria-selected="true">HTML</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="css-tab" data-bs-toggle="tab" data-bs-target="#cssPane"
                                type="button" role="tab" aria-controls="cssPane" aria-selected="false">CSS</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="js-tab" data-bs-toggle="tab" data-bs-target="#jsPane"
                                type="button" role="tab" aria-controls="jsPane" aria-selected="false">JavaScript</button>
                    </li>
                </ul>

                <div class="tab-content" id="editorTabContent">
                    <div class="tab-pane fade show active" id="htmlPane" role="tabpanel" aria-labelledby="html-tab">
                        <textarea asp-for="HtmlContent" id="htmlContent" style="display:none;"></textarea>
                        <div id="htmlEditor" style="height:480px;border:1px solid #ddd;border-top:none;"></div>
                    </div>
                    <div class="tab-pane fade" id="cssPane" role="tabpanel" aria-labelledby="css-tab">
                        <textarea asp-for="CssContent" id="cssContent" style="display:none;"></textarea>
                        <div id="cssEditor" style="height:480px;border:1px solid #ddd;border-top:none;"></div>
                    </div>
                    <div class="tab-pane fade" id="jsPane" role="tabpanel" aria-labelledby="js-tab">
                        <textarea asp-for="JsContent" id="jsContent" style="display:none;"></textarea>
                        <div id="jsEditor" style="height:480px;border:1px solid #ddd;border-top:none;"></div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button id="saveBtn" type="submit" class="btn-cms btn-cms-primary">Create</button>
                <button id="saveAsTemplateBtn" type="button" class="btn-cms btn-cms-secondary" style="display:none;"
                        onclick="saveAsTemplate()">
                    💾 Lưu Template
                </button>
                <a asp-action="Index" asp-route-pageId="@pageId" class="btn-cms btn-cms-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<style>
    .template-card {
        width: 200px;
        border: 2px solid #ddd;
        border-radius: 8px;
        padding: 24px 16px;
        cursor: pointer;
        text-align: center;
        transition: border-color 0.2s, box-shadow 0.2s;
        background: #fff;
    }
    .template-card:hover {
        border-color: #00a88e !important;
        box-shadow: 0 4px 12px rgba(0,168,142,0.15);
    }
    .template-card .template-icon {
        font-size: 36px;
        margin-bottom: 12px;
        color: #888;
    }
    .template-card h5 {
        margin: 0 0 6px 0;
        font-weight: 600;
    }
    .template-card p {
        margin: 0;
        font-size: 13px;
        color: #888;
    }
    .create-own-card {
        border-style: dashed;
        border-color: #00a88e;
    }
    .create-own-card .template-icon { color: #00a88e; }
    .create-own-card h5 { color: #00a88e; }
    .custom-template-card {
        border-color: #c5a3ff;
    }
    .custom-template-card:hover {
        border-color: #9b6dff !important;
        box-shadow: 0 4px 12px rgba(155,109,255,0.15);
    }
    .custom-template-card .delete-tmpl {
        position: absolute;
        top: 6px;
        right: 6px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #e74c3c;
        color: #fff;
        font-size: 13px;
        line-height: 22px;
        text-align: center;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.15s;
    }
    .custom-template-card:hover .delete-tmpl { opacity: 1; }

    .data-field-group { margin-bottom: 14px; }
    .data-field-group label { display: block; font-weight: 600; margin-bottom: 4px; font-size: 13px; color: #333; }
    .data-field-group input,
    .data-field-group textarea { width: 100%; padding: 8px 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; }
    .data-field-group textarea { min-height: 80px; resize: vertical; }

    .data-field-fieldset {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 16px;
        background: #fafafa;
    }
    .data-field-fieldset-legend {
        font-weight: 700;
        font-size: 14px;
        color: #555;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e5e7eb;
    }
    .data-field-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }
    .data-field-row .data-field-group {
        flex: 1;
        min-width: 200px;
        margin-bottom: 0;
    }
</style>

@section Scripts {
    <script src="~/lib/monaco/vs/loader.js"></script>
    <script>
        require.config({ paths: { 'vs': '/lib/monaco/vs' }});
        var htmlEditor, cssEditor, jsEditor;
        var templateManifest = [];
        var isCustomTemplateMode = false;
        var isTemplateDataMode = false; // true = data form, false = raw editors
        var activeTemplateHtml = '';

        // ── Extract {{KEY}} placeholders from template HTML ──
        function extractPlaceholders(html) {
            var matches = html.match(/\{\{([A-Z0-9_]+)\}\}/g) || [];
            var keys = [], seen = {};
            matches.forEach(function (m) {
                var key = m.replace(/[{}]/g, '');
                if (!seen[key]) { seen[key] = true; keys.push(key); }
            });
            return keys;
        }

        // ── Build the data form from placeholder keys ──
        function buildDataForm(keys) {
            var container = document.getElementById('dataForm');
            container.innerHTML = '';

            // Group keys by prefix (e.g., PARTNER_1_IMAGE + PARTNER_1_URL → group "PARTNER_1")
            var groups = {};
            var ungrouped = [];
            keys.forEach(function (key) {
                var match = key.match(/^(.+?)_(URL|IMAGE|HREF|TITLE|DESC|NAME|TAG|QUOTE|LABEL|TEXT)$/);
                if (match) {
                    var prefix = match[1];
                    if (!groups[prefix]) groups[prefix] = [];
                    groups[prefix].push(key);
                } else {
                    ungrouped.push(key);
                }
            });

            // Render ungrouped fields first
            ungrouped.forEach(function (key) {
                container.appendChild(createFieldElement(key, ''));
            });

            // Render grouped fields
            var renderedKeys = {};
            ungrouped.forEach(function (k) { renderedKeys[k] = true; });

            Object.keys(groups).forEach(function (prefix) {
                var groupKeys = groups[prefix];
                if (groupKeys.length === 1 && !renderedKeys[groupKeys[0]]) {
                    // Single field in group — render standalone
                    container.appendChild(createFieldElement(groupKeys[0], ''));
                    return;
                }
                var fieldset = document.createElement('div');
                fieldset.className = 'data-field-fieldset';
                var legend = document.createElement('div');
                legend.className = 'data-field-fieldset-legend';
                legend.textContent = humanize(prefix);
                fieldset.appendChild(legend);
                var row = document.createElement('div');
                row.className = 'data-field-row';
                groupKeys.forEach(function (key) {
                    row.appendChild(createFieldElement(key, ''));
                });
                fieldset.appendChild(row);
                container.appendChild(fieldset);
            });
        }

        // ── Create a single form field element ──
        function createFieldElement(key, value) {
            var group = document.createElement('div');
            group.className = 'data-field-group';

            var label = document.createElement('label');
            label.textContent = humanize(key);
            group.appendChild(label);

            var input;
            var suffix = key.split('_').pop();
            var isUrl = suffix === 'URL' || suffix === 'HREF';
            var isImage = suffix === 'IMAGE';
            var isLong = (suffix === 'DESC' || suffix === 'QUOTE' || suffix === 'SUBTITLE') || value.length > 80;

            if (isLong) {
                input = document.createElement('textarea');
                input.rows = 3;
            } else {
                input = document.createElement('input');
                input.type = 'text';
            }

            if (isImage) input.placeholder = 'https://example.com/image.jpg';
            else if (isUrl) input.placeholder = 'https://... hoặc #';
            else input.placeholder = '{{' + key + '}}';

            input.name = 'data_' + key;
            input.value = value;
            input.dataset.key = key;
            input.className = 'data-input';
            group.appendChild(input);

            return group;
        }

        // ── Convert UPPER_SNAKE_CASE to human-readable label ──
        function humanize(key) {
            return key
                .split('_')
                .map(function (w) { return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase(); })
                .join(' ');
        }

        // ── Show template data mode ──
        function showTemplateDataMode(templateName, templateHtml, templateId) {
            isTemplateDataMode = true;
            activeTemplateHtml = templateHtml;

            document.getElementById('templatePicker').style.display = 'none';
            document.getElementById('editorSection').style.display = 'block';
            document.getElementById('rawEditorSection').style.display = 'none';
            document.getElementById('dataFormSection').style.display = 'block';
            document.getElementById('templateInfoBanner').style.display = 'block';
            document.getElementById('templateInfoName').textContent = templateName;
            document.getElementById('templatePreview').textContent = templateHtml;
            document.getElementById('templateIdField').value = templateId;

            var keys = extractPlaceholders(templateHtml);
            buildDataForm(keys);
        }

        // ── Show raw editor mode ──
        function showRawEditorMode(initialHtml, initialCss, initialJs) {
            isTemplateDataMode = false;
            activeTemplateHtml = '';

            document.getElementById('templatePicker').style.display = 'none';
            document.getElementById('editorSection').style.display = 'block';
            document.getElementById('rawEditorSection').style.display = 'block';
            document.getElementById('dataFormSection').style.display = 'none';
            document.getElementById('templateInfoBanner').style.display = 'none';
            document.getElementById('templateIdField').value = '';

            initEditors(initialHtml, initialCss, initialJs);
        }

        // ── Load built-in templates from manifest ──
        (function () {
            var container = document.getElementById('templateCards');
            var createOwnCard = container.querySelector('.create-own-card');

            fetch('/templates/templates.json')
                .then(function (r) { return r.json(); })
                .then(function (templates) {
                    templateManifest = templates;
                    templates.forEach(function (t) {
                        var card = document.createElement('div');
                        card.className = 'template-card';
                        card.onclick = function () { selectTemplate(t.id); };
                        card.innerHTML =
                            '<div class="template-icon">' + t.icon + '</div>' +
                            '<h5>' + t.name + '</h5>' +
                            '<p>' + t.description + '</p>';
                        container.insertBefore(card, createOwnCard);
                    });

                    return fetch('/api/custom-templates');
                })
                .then(function (r) { return r.json(); })
                .then(function (customs) {
                    customs.forEach(function (ct) {
                        var card = document.createElement('div');
                        card.className = 'template-card custom-template-card';
                        card.style.position = 'relative';
                        card.onclick = function (e) {
                            if (e.target.classList.contains('delete-tmpl')) return;
                            selectCustomTemplate(ct.id, ct.name);
                        };
                        var numericId = ct.id.replace('custom-', '');
                        card.innerHTML =
                            '<div class="delete-tmpl" title="Xoá template" onclick="deleteCustomTemplate(' + numericId + ', this.parentElement)">×</div>' +
                            '<div class="template-icon">' + ct.icon + '</div>' +
                            '<h5>' + ct.name + '</h5>' +
                            '<p>' + ct.description + '</p>';
                        container.insertBefore(card, createOwnCard);
                    });
                });
        })();

        // ── Fetch a built-in template file ──
        function fetchTemplateFile(filename) {
            if (!filename) return Promise.resolve('');
            return fetch('/templates/' + filename)
                .then(function (r) { return r.ok ? r.text() : ''; })
                .catch(function () { return ''; });
        }

        // ── Select a built-in template (always raw mode — file-based, no DB template ID) ──
        function selectTemplate(templateId) {
            isCustomTemplateMode = false;
            document.getElementById('saveAsTemplateBtn').style.display = 'none';
            document.getElementById('customTemplateMeta').style.display = 'none';

            var tmpl = templateManifest.find(function (t) { return t.id === templateId; });
            var files = (tmpl && tmpl.files) || {};

            Promise.all([
                fetchTemplateFile(files.html),
                fetchTemplateFile(files.css),
                fetchTemplateFile(files.js)
            ]).then(function (results) {
                showRawEditorMode(results[0], results[1], results[2]);
            });
        }

        // ── Select a custom template — if it has placeholders, show data form ──
        function selectCustomTemplate(compositeId, templateName) {
            isCustomTemplateMode = false;
            document.getElementById('saveAsTemplateBtn').style.display = 'none';
            document.getElementById('customTemplateMeta').style.display = 'none';

            var numericId = compositeId.replace('custom-', '');
            fetch('/api/custom-templates/' + numericId)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var placeholders = extractPlaceholders(data.html || '');
                    if (placeholders.length > 0) {
                        // Template has placeholders — use data form mode
                        showTemplateDataMode(templateName || data.name, data.html, data.id);
                    } else {
                        // No placeholders — use raw editor mode, pre-filled
                        showRawEditorMode(data.html, data.css, data.js);
                    }
                });
        }

        // ── Delete a custom template ──
        function deleteCustomTemplate(id, cardEl) {
            if (!confirm('Xoá template này?')) return;
            fetch('/api/custom-templates/' + id, { method: 'DELETE' })
                .then(function (r) {
                    if (r.ok && cardEl) cardEl.remove();
                });
        }

        // ── "Create Your Own" — go directly to editor with metadata fields ──
        function startCustomTemplate() {
            isCustomTemplateMode = true;
            document.getElementById('customTemplateMeta').style.display = 'block';
            document.getElementById('saveAsTemplateBtn').style.display = '';
            showRawEditorMode('', '', '');
        }

        // ── Save current editor content as a reusable custom template ──
        function saveAsTemplate() {
            if (!htmlEditor) return;

            var name = document.getElementById('tmplName').value.trim();
            if (!name) { alert('Vui lòng nhập tên template.'); return; }

            var payload = {
                name: name,
                icon: document.getElementById('tmplIcon').value.trim() || '🧩',
                description: document.getElementById('tmplDesc').value.trim() || '',
                html: htmlEditor.getValue(),
                css: cssEditor.getValue(),
                js: jsEditor.getValue()
            };

            fetch('/api/custom-templates', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.id) {
                    alert('Template "' + name + '" đã được lưu!');
                    document.getElementById('saveAsTemplateBtn').style.display = 'none';
                    isCustomTemplateMode = false;
                } else {
                    alert('Lỗi: ' + (data.error || 'Không thể lưu template.'));
                }
            })
            .catch(function () {
                alert('Lỗi kết nối, không thể lưu template.');
            });
        }

        // ── Initialise Monaco editors with given content ──
        function initEditors(initialHtml, initialCss, initialJs) {
            document.getElementById('saveBtn').disabled = true;

            require(['vs/editor/editor.main'], function () {
                htmlEditor = monaco.editor.create(document.getElementById('htmlEditor'), {
                    value: initialHtml || '',
                    language: 'html',
                    automaticLayout: true,
                    minimap: { enabled: false }
                });
                cssEditor = monaco.editor.create(document.getElementById('cssEditor'), {
                    value: initialCss || '',
                    language: 'css',
                    automaticLayout: true,
                    minimap: { enabled: false }
                });
                jsEditor = monaco.editor.create(document.getElementById('jsEditor'), {
                    value: initialJs || '',
                    language: 'javascript',
                    automaticLayout: true,
                    minimap: { enabled: false }
                });
                document.getElementById('saveBtn').disabled = false;

                document.querySelectorAll('#editorTabs button[data-bs-toggle="tab"]').forEach(function (tab) {
                    tab.addEventListener('shown.bs.tab', function () {
                        if (htmlEditor) htmlEditor.layout();
                        if (cssEditor) cssEditor.layout();
                        if (jsEditor) jsEditor.layout();
                    });
                });
            });
        }

        function syncEditors() {
            if (isTemplateDataMode) {
                // Template mode: collect data inputs into DataJson
                var data = {};
                document.querySelectorAll('.data-input').forEach(function (el) {
                    data[el.dataset.key] = el.value;
                });
                document.getElementById('dataJsonField').value = JSON.stringify(data);
                // Set a placeholder for the required HtmlContent field
                document.getElementById('htmlContent').value = '<!-- rendered from template -->';
                return true;
            } else {
                // Raw mode: sync Monaco editors
                if (htmlEditor) document.getElementById('htmlContent').value = htmlEditor.getValue();
                if (cssEditor) document.getElementById('cssContent').value = cssEditor.getValue();
                if (jsEditor) document.getElementById('jsContent').value = jsEditor.getValue();
                return true;
            }
        }
    </script>
}
