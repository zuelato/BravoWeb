@model BravoWeb.Models.ContentFragment
@{
    ViewData["Title"] = "Create Content Fragment";
    int? pageId = ViewBag.PageId as int?;
}

<h1>Create Content Fragment</h1>

<form asp-action="Create" method="post" onsubmit="return syncEditor()">
    @Html.AntiForgeryToken()
    <input type="hidden" name="PageId" value="@(pageId?.ToString() ?? "")" />
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label asp-for="DisplayOrder"></label>
        <input asp-for="DisplayOrder" type="number" />
    </div>
    <div>
        <label asp-for="HtmlContent">HTML Content</label>
        <textarea asp-for="HtmlContent" id="htmlContent" style="display:none;" rows="15" cols="80"></textarea>
        <div id="monacoEditor" style="height:480px;border:1px solid #ddd;"></div>
    </div>

    <div>
        <button id="saveBtn" type="submit">Create</button>
        <a asp-action="Index" asp-route-pageId="@pageId">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="~/lib/monaco/vs/loader.js"></script>
    <script>
        require.config({ paths: { 'vs': '/lib/monaco/vs' }});
        var editor;
        document.getElementById('saveBtn').disabled = true;

        require(['vs/editor/editor.main'], function () {
            var initial = document.getElementById('htmlContent').value || '';
            editor = monaco.editor.create(document.getElementById('monacoEditor'), {
                value: initial,
                language: 'html',
                automaticLayout: true,
                minimap: { enabled: false }
            });
            document.getElementById('saveBtn').disabled = false;
        });

        function syncEditor() {
            if (editor) {
                document.getElementById('htmlContent').value = editor.getValue();
            }
            return true;
        }
    </script>
}
