@{
    ViewData["Title"] = "Access Denied - BravoWeb";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Access Denied</h4>
                <p>You don't have permission to access this resource. If you believe this is an error, please contact your administrator.</p>
                <hr>
                <div class="btn-group" role="group">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to Home</a>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-secondary">Logout</a>
                </div>
            </div>
        </div>
    </div>
</div>
