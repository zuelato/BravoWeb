@* Testimonials component view *@
<link rel="stylesheet" href="~/css/testimonials.css" asp-append-version="true" />

<div class="testimonials-section section-container">
    <div class="content">
        <div class="upper-section-content">
            <div class="section-name">
                <div class="name"><p>TESTIMONIALS</p></div>
                <div class="divider"><div class="divider-left"></div></div>
            </div>
            <div class="section-title"><div class="title"><p>Ph?n h?i t? khách hàng</p></div></div>
        </div>
        <div class="lower-section-content">
            <!-- Carousel content reused from previous partial -->
            <div class="carousel-container" id="testimonials-carousel">
                <div class="carousel-track">
                    <div class="carousel-card"><div class="carousel-card-upper-section"><div class="carousel-card-upper-section-portrait"></div><div class="carousel-card-upper-section-title"><div class="testimonial-carousel-name">&testimonial-name</div><div class="testimonial-carousel-title">&testimonial-title</div></div></div><div class="carousel-card-lower-section">&testimonial-comment</div></div>
                    <div class="carousel-card"><div class="carousel-card-upper-section"><div class="carousel-card-upper-section-portrait"></div><div class="carousel-card-upper-section-title"><div class="testimonial-carousel-name">&testimonial-name</div><div class="testimonial-carousel-title">&testimonial-title</div></div></div><div class="carousel-card-lower-section">&testimonial-comment</div></div>
                    <div class="carousel-card"><div class="carousel-card-upper-section"><div class="carousel-card-upper-section-portrait"></div><div class="carousel-card-upper-section-title"><div class="testimonial-carousel-name">&testimonial-name</div><div class="testimonial-carousel-title">&testimonial-title</div></div></div><div class="carousel-card-lower-section">&testimonial-comment</div></div>
                </div>
            </div>
            <div class="carousel-controller"><div class="carousel-controller-prev-nav" id="carousel-prev"><p>&lt;</p></div><div class="carousel-controller-next-nav" id="carousel-next"><p>&gt;</p></div></div>
        </div>
    </div>
</div>

<script src="~/js/testimonials.js" asp-append-version="true"></script>