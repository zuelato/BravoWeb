<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BravoWeb</title>

    <!-- BravoWeb MEC Design System -->
    <link rel="stylesheet" href="~/css/bravo-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BravoWeb.styles.css" asp-append-version="true" />

    @* Render component-specific styles registered by controller *@
    @{
        var compStyles = ViewData["componentStyles"] as List<string>;
        if (compStyles != null)
        {
            foreach (var href in compStyles)
            {
                <link rel="stylesheet" href="@href" />
            }
        }
    }
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar">
        <div class="container navbar-container">
            <div class="navbar-brand">
                <a href="/">BravoWeb</a>
            </div>

            <ul class="navbar-menu">
                <li><a href="/">Home</a></li>
                <li><a href="/#about">About</a></li>
                <li><a href="/#services">Services</a></li>
                <li><a href="/#products">Products</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li><a href="/AdminDashboard">Dashboard</a></li>
                    <li>
                        <form action="/Auth/Logout" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm" style="background:transparent; padding:0; color:inherit;">Logout</button>
                        </form>
                    </li>
                }
                else
                {
                    <li><a href="/Auth/Login">Admin</a></li>
                }
            </ul>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer mt-5">
        <div class="container footer-content py-4">
            <div class="grid grid-3 gap-3">
                <!-- Company Info -->
                <div>
                    <h5>BravoWeb CMS</h5>
                    <p class="text-muted" style="font-size:14px;">
                        Modern enterprise content management system for building and managing dynamic websites.
                    </p>
                </div>

                <!-- Quick Links -->
                <div>
                    <h5>Quick Links</h5>
                    <ul style="list-style:none; padding:0;">
                        <li><a href="/">Home</a></li>
                        <li><a href="/AdminDashboard">Admin</a></li>
                        <li><a href="/Auth/Login">Login</a></li>
                    </ul>
                </div>

                <!-- Contact -->
                <div>
                    <h5>Contact</h5>
                    <ul style="list-style:none; padding:0; font-size:14px;">
                        <li>Email: info@bravoweb.com</li>
                        <li>Phone: (123) 456-7890</li>
                        <li>Address: Your City, Country</li>
                    </ul>
                </div>
            </div>

            <!-- Copyright -->
            <div class="footer-bottom" style="border-top:1px solid var(--color-gray-200); margin-top:32px; padding-top:24px; text-align:center; color:var(--color-gray-500);">
                <p>&copy; 2025 BravoWeb. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
