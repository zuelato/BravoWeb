@model List<BravoWeb.Models.ContentFragment>
@{
    ViewData["Title"] = "Home Page";
}

<main>
    <div class="site-body">
        @foreach (var fragment in Model)
        {
            if (!string.IsNullOrWhiteSpace(fragment.CssContent))
            {
                @Html.Raw($"<style>{fragment.CssContent}</style>")
            }
            @Html.Raw(fragment.HtmlContent)
            if (!string.IsNullOrWhiteSpace(fragment.JsContent))
            {
                @Html.Raw($"<script>{fragment.JsContent}</script>")
            }
        }
    </div>
</main>
