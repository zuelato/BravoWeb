@using BravoWeb.Services
@model List<BravoWeb.Models.ContentFragment>
@{
    ViewData["Title"] = "Home Page";
    var renderer = (TemplateRenderer)ViewBag.Renderer;
    var renderedTemplateJsIds = new HashSet<int>();
}

<main>
    <div class="site-body">
        @foreach (var fragment in Model)
        {
            var scopeId = $"fragment-{fragment.Id}";
            var scopeSelector = $"#{scopeId}";

            // template -> use template html/css/js merged with datajson
            // otherwise -> fragment's own content (legacy)
            var isTemplateBased = fragment.TemplateId.HasValue && fragment.Template != null;

            var effectiveHtml = isTemplateBased
                ? renderer.Render(fragment.Template!.HtmlContent ?? "", fragment.DataJson)
                : fragment.HtmlContent;

            var effectiveCss = isTemplateBased
                ? fragment.Template!.CssContent
                : fragment.CssContent;

            var effectiveJs = isTemplateBased
                ? fragment.Template!.JsContent
                : fragment.JsContent;

            // deduplicate js per template (avoid duplicate event listeners)
            var shouldEmitJs = true;
            if (isTemplateBased)
            {
                if (renderedTemplateJsIds.Contains(fragment.TemplateId!.Value))
                {
                    shouldEmitJs = false;
                }
                else
                {
                    renderedTemplateJsIds.Add(fragment.TemplateId!.Value);
                }
            }

            var scopedCss = !string.IsNullOrWhiteSpace(effectiveCss)
                ? CssScoper.Scope(effectiveCss, scopeSelector)
                : null;

            if (scopedCss != null)
            {
                @Html.Raw("<style>" + scopedCss + "</style>")
            }
            <div id="@scopeId">
                @Html.Raw(effectiveHtml)
            </div>
            if (shouldEmitJs && !string.IsNullOrWhiteSpace(effectiveJs))
            {
                @Html.Raw("<script>" + effectiveJs + "</script>")
            }
        }
    </div>
</main>
