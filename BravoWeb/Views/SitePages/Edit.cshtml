@model BravoWeb.Models.SitePage
@{
    ViewData["Title"] = "Edit Page";
}

<div class="cms-page">
    <h1>Edit Page</h1>

    <form asp-action="Edit" method="post" class="cms-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Slug">URL Slug</label>
            <input asp-for="Slug" />
            <span asp-validation-for="Slug" class="validation-error"></span>
        </div>
        <div class="form-group">
            <div class="form-check">
                <input asp-for="IsPublished" type="checkbox" />
                <label asp-for="IsPublished">Published</label>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-cms btn-cms-primary">Save</button>
            <a asp-action="Index" class="btn-cms btn-cms-secondary">Cancel</a>
        </div>
    </form>
</div>
