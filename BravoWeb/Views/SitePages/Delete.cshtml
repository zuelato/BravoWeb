@model BravoWeb.Models.SitePage
@{
    ViewData["Title"] = "Delete Page";
}

<div class="cms-page">
    <h1>Delete Page</h1>

    <div class="cms-confirm-card">
        <p>Are you sure you want to delete the page <strong>@Model.Title</strong> (<code>/@Model.Slug</code>)?</p>
        <p>This will also delete all content fragments associated with this page.</p>

        <form asp-action="Delete" method="post" class="cms-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="form-actions">
                <button type="submit" class="btn-cms btn-cms-danger">Delete</button>
                <a asp-action="Index" class="btn-cms btn-cms-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
