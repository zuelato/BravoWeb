@model IEnumerable<BravoWeb.Models.SitePage>
@{
    ViewData["Title"] = "Site Pages";
}

<h1>Site Pages</h1>

<p>
    <a asp-action="Create">Create New Page</a>
</p>

<table>
    <thead>
        <tr>
            <th>Title</th>
            <th>Slug (URL)</th>
            <th>Published</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sp in Model)
        {
            <tr>
                <td>@sp.Title</td>
                <td>/@sp.Slug</td>
                <td>@(sp.IsPublished ? "Yes" : "No")</td>
                <td>
                    <a asp-controller="ContentFragments" asp-action="Index" asp-route-pageId="@sp.Id">Manage Fragments</a> |
                    <a asp-action="Edit" asp-route-id="@sp.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@sp.Id">Delete</a> |
                    <a href="/@sp.Slug" target="_blank">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />
<h3>Home Page</h3>
<p>
    <a asp-controller="ContentFragments" asp-action="Index">Manage Home Page Fragments</a>
</p>
