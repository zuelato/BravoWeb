@page "{id?}"
@model BravoWeb.Pages.Admin.Fragments.EditModel
@{
    ViewData["Title"] = Model.Fragment?.Id == 0 ? "Create Fragment" : "Edit Fragment";
}

<h2>@ViewData["Title"]</h2>

<form method="post" onsubmit="return syncEditor()">
    @Html.AntiForgeryToken()
    <input asp-for="Fragment.Id" type="hidden" />
    <div>
        <label asp-for="Fragment.Name"></label>
        <input asp-for="Fragment.Name" />
        <span asp-validation-for="Fragment.Name"></span>
    </div>
    <div>
        <label asp-for="Fragment.DisplayOrder"></label>
        <input asp-for="Fragment.DisplayOrder" type="number" />
    </div>

    <div>
        <label>HTML Content</label>
        <textarea id="htmlContent" asp-for="Fragment.HtmlContent" style="display:none;"></textarea>
        <div id="editor" style="height:360px;border:1px solid #ddd;"></div>
    </div>

    <div>
        <button id="saveBtn" type="submit">Save</button>
        <a asp-page="./Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="~/lib/monaco/vs/loader.js"></script>
    <script>
        require.config({ paths: { 'vs': '/lib/monaco/vs' }});
        let editor;
        document.getElementById('saveBtn').disabled = true;

        require(['vs/editor/editor.main'], function () {
            const initial = document.getElementById('htmlContent').value || '';
            editor = monaco.editor.create(document.getElementById('editor'), {
                value: initial,
                language: 'html',
                automaticLayout: true,
                minimap: { enabled: false }
            });
            document.getElementById('saveBtn').disabled = false;
        });

        function syncEditor() {
            if (editor) {
                document.getElementById('htmlContent').value = editor.getValue();
            }
            return true;
        }
    </script>
}
